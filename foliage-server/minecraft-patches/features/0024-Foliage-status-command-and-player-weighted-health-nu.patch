diff --git a/io/papermc/paper/threadedregions/commands/FoliageMetrics.java b/io/papermc/paper/threadedregions/commands/FoliageMetrics.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3de68fd256bcdc513b8c319348a0ebbac75fd32
--- /dev/null
+++ b/io/papermc/paper/threadedregions/commands/FoliageMetrics.java
@@ -0,0 +1,95 @@
+package io.papermc.paper.threadedregions.commands;
+
+import ca.spottedleaf.common.time.TickData;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegions;
+import it.unimi.dsi.fastutil.doubles.DoubleArrayList;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.craftbukkit.CraftWorld;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Player-facing health numbers (Foliage).
+ * <p>
+ * Region TPS alone hides who is affected: one laggy region with nobody in it does not matter, one with everybody in it
+ * does. So, like EndRod, every number here is weighted by the players standing in each region:
+ * <ul>
+ *     <li>felt TPS: average of the TPS of the region each player is in;</li>
+ *     <li>lagging players: players whose region is below {@link #LAG_TPS} TPS;</li>
+ *     <li>worst region TPS by rank (1st, 5th, 10th, 20th worst).</li>
+ * </ul>
+ * Only reads region reports that the regionizer already keeps; nothing is measured here.
+ */
+public final class FoliageMetrics {
+
+    public static final double LAG_TPS = 15.0;
+    public static final int[] WORST_RANKS = {1, 5, 10, 20};
+
+    public record RegionEntry(ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region,
+                              TickData.TickReportData report, double tps, int players) {
+    }
+
+    public record Snapshot(List<RegionEntry> regions, Map<String, Integer> regionsPerWorld, int players,
+                           double feltTps, int laggingPlayers, double[] worstByRank) {
+
+        public double laggingPercent() {
+            return this.players == 0 ? 0.0 : this.laggingPlayers * 100.0 / this.players;
+        }
+
+        public double playersPerRegion() {
+            return this.regions.isEmpty() ? 0.0 : (double) this.players / this.regions.size();
+        }
+    }
+
+    private FoliageMetrics() {
+    }
+
+    public static Snapshot compute() {
+        final List<RegionEntry> entries = new ArrayList<>();
+        final Map<String, Integer> perWorld = new LinkedHashMap<>();
+        final long now = System.nanoTime();
+
+        for (final World bukkitWorld : Bukkit.getWorlds()) {
+            final ServerLevel world = ((CraftWorld) bukkitWorld).getHandle();
+            final int[] count = {0};
+            world.regioniser.computeForAllRegions(region -> {
+                final TickData.TickReportData report = region.getData().getRegionSchedulingHandle().getTickReport15s(now);
+                final double tps = report == null ? 20.0 : report.tpsData().segmentAll().average();
+                final int players = region.getData().getRegionStats().getPlayerCount();
+                entries.add(new RegionEntry(region, report, tps, players));
+                ++count[0];
+            });
+            if (count[0] > 0) {
+                perWorld.put(bukkitWorld.getName(), count[0]);
+            }
+        }
+
+        int players = 0;
+        int lagging = 0;
+        double weighted = 0.0;
+        final DoubleArrayList tpsList = new DoubleArrayList(entries.size());
+        for (final RegionEntry e : entries) {
+            players += e.players();
+            weighted += e.tps() * e.players();
+            if (e.tps() < LAG_TPS) {
+                lagging += e.players();
+            }
+            tpsList.add(e.tps());
+        }
+        tpsList.sort(null);
+
+        final double[] worst = new double[WORST_RANKS.length];
+        for (int i = 0; i < WORST_RANKS.length; ++i) {
+            final int idx = WORST_RANKS[i] - 1;
+            worst[i] = idx < tpsList.size() ? tpsList.getDouble(idx) : Double.NaN;
+        }
+
+        final double felt = players == 0 ? Double.NaN : weighted / players;
+        return new Snapshot(entries, perWorld, players, felt, lagging, worst);
+    }
+}
