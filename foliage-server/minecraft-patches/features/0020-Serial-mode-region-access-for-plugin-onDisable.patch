Subject: [PATCH] Serial mode region access for plugin onDisable


diff --git a/io/papermc/paper/threadedregions/RegionizedWorldData.java b/io/papermc/paper/threadedregions/RegionizedWorldData.java
index 2f620ef15a8736e4fb52f57616776f69c2ff990b..70ce24e958962825b66ac2a7633ddefb264053de 100644
--- a/io/papermc/paper/threadedregions/RegionizedWorldData.java
+++ b/io/papermc/paper/threadedregions/RegionizedWorldData.java
@@ -350,6 +350,14 @@ public final class RegionizedWorldData {
     public ReferenceList<Entity> trackerEntities = new ReferenceList<>(EMPTY_ENTITY_ARRAY); // Moonrise - entity tracker
 
     // Foliage start - plugin compatibility: visit the tracked entities of every region of a world (read-only use)
+    // Foliage start - serial mode: world data of the region owning a chunk, for threads outside any region (shutdown)
+    public static RegionizedWorldData foliage$ownerOf(final ServerLevel world, final int chunkX, final int chunkZ) {
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+            world.regioniser.getRegionAtUnsynchronised(chunkX, chunkZ);
+        return region == null ? null : region.getData().getRegionizedData(world.worldRegionData);
+    }
+    // Foliage end - serial mode
+
     public static void forEachTrackerEntity(final ServerLevel world, final java.util.function.Consumer<Entity> consumer) {
         world.regioniser.computeForAllRegionsUnsynchronised(region -> {
             final RegionizedWorldData data = region.getData().getRegionizedData(world.worldRegionData);
diff --git a/io/papermc/paper/threadedregions/TickRegionScheduler.java b/io/papermc/paper/threadedregions/TickRegionScheduler.java
index 9e87462a036ea6846deb22fbb1b189792368bdb1..293902f4dc9f9c449cc0b06d2b56f238284fc151 100644
--- a/io/papermc/paper/threadedregions/TickRegionScheduler.java
+++ b/io/papermc/paper/threadedregions/TickRegionScheduler.java
@@ -166,13 +166,21 @@ public final class TickRegionScheduler {
 
     /** Threads that may switch the current region: region tick threads, and the server thread in serial mode. */
     public static boolean canSwapTickingRegion() {
-        return Thread.currentThread() instanceof TickThreadRunner || isSerialServerThread();
+        return Thread.currentThread() instanceof TickThreadRunner || isSerialServerThread()
+            || (io.github.clre20.foliage.compat.SerialMode.ENABLED && Thread.currentThread() instanceof RegionShutdownThread); // Foliage - serial mode
     }
 
     public static ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> swapTickingRegion(
         final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region
     ) {
         if (!(Thread.currentThread() instanceof TickThreadRunner tickThreadRunner)) {
+            // Foliage start - serial mode: plugin onDisable runs on the region shutdown thread, which tracks its region itself
+            if (io.github.clre20.foliage.compat.SerialMode.ENABLED && Thread.currentThread() instanceof RegionShutdownThread shutdownThread) {
+                final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> previous = shutdownThread.shuttingDown;
+                shutdownThread.shuttingDown = region;
+                return previous;
+            }
+            // Foliage end - serial mode
             // the server thread (startup, plugin enable) keeps its current region in static fields
             if (!isSerialServerThread()) {
                 throw new IllegalStateException("Must be tick thread runner or the server thread in serial mode");
diff --git a/io/papermc/paper/threadedregions/TickRegions.java b/io/papermc/paper/threadedregions/TickRegions.java
index ac80b6c1e33c65a2fb6a158bb07dfb6b48798827..d79dca29b6cd5548379ec682eabf20e070b64e88 100644
--- a/io/papermc/paper/threadedregions/TickRegions.java
+++ b/io/papermc/paper/threadedregions/TickRegions.java
@@ -179,7 +179,13 @@ public final class TickRegions implements ThreadedRegionizer.RegionCallbacks<Tic
         }
 
         static void updateCurrentRegion() {
-            TickRegionScheduler.getCurrentRegion().getData().getRegionStats().updateFrom(TickRegionScheduler.getCurrentRegionizedWorldData());
+            // Foliage start - serial mode: entity changes from the shutdown thread have no current region; stats only
+            final ThreadedRegionizer.ThreadedRegion<TickRegionData, TickRegionSectionData> foliageRegion = TickRegionScheduler.getCurrentRegion();
+            if (foliageRegion == null) {
+                return;
+            }
+            // Foliage end - serial mode
+            foliageRegion.getData().getRegionStats().updateFrom(TickRegionScheduler.getCurrentRegionizedWorldData());
         }
     }
 
