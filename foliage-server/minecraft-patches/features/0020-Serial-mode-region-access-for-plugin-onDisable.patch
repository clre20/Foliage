-                ServerLevel.this.getCurrentWorldData().removeNavigatingMob(mob); // Folia - region threading
+                ServerLevel.this.foliage$entityWorldData(mob).removeNavigatingMob(mob); // Folia - region threading // Foliage - serial mode
