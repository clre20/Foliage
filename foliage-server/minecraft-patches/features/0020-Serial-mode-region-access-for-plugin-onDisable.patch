         return this.getGameRules().get(GameRules.SPAWNER_BLOCKS_WORK);
     }
 
+    // Foliage start - serial mode: plugins remove entities from onDisable on the region shutdown thread (Shopkeepers);
+    // the regions are halted there, so update the region that owns the entity directly like Paper does
+    private io.papermc.paper.threadedregions.RegionizedWorldData foliage$entityWorldData(final Entity entity) {
+        final io.papermc.paper.threadedregions.RegionizedWorldData current = this.getCurrentWorldData();
+        if (current != null || !io.github.clre20.foliage.compat.SerialMode.ENABLED || !ca.spottedleaf.moonrise.common.util.TickThread.isShutdownThread()) {
+            return current;
+        }
+        return io.papermc.paper.threadedregions.RegionizedWorldData.foliage$ownerOf(this, entity.getBlockX() >> 4, entity.getBlockZ() >> 4);
+    }
+    // Foliage end - serial mode
+
     private final class EntityCallbacks implements LevelCallback<Entity> {
         @Override
         public void onCreated(final Entity entity) {
@@ -3228,7 +3239,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
         @Override
         public void onTickingEnd(final Entity entity) {
-            ServerLevel.this.getCurrentWorldData().removeEntityTickingEntity(entity); // Folia - region threading
+            ServerLevel.this.foliage$entityWorldData(entity).removeEntityTickingEntity(entity); // Folia - region threading // Foliage - serial mode
             // Paper start - Reset pearls when they stop being ticked
             if (ServerLevel.this.paperConfig().fixes.disableUnloadedChunkEnderpearlExploit && ServerLevel.this.paperConfig().misc.legacyEnderPearlBehavior && entity instanceof net.minecraft.world.entity.projectile.throwableitemprojectile.ThrownEnderpearl pearl) {
                 pearl.setOwner(null);
@@ -3290,7 +3301,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
