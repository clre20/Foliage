         }
@@ -334,6 +339,11 @@ public final class RegionBridgeTransformer {
                     mv.visitVarInsn(Opcodes.ILOAD, slots[2]);
                     mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterWorldBlock", "(Ljava/lang/Object;II)Ljava/lang/Object;", false);
                 }
+                case REFLECT -> { // (method, target, args)
