+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterReflective", "(Ljava/lang/Object;[Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
                 case ARG_ENTITY -> {
                     mv.visitVarInsn(Opcodes.ALOAD, slots[bridge.argIndex() + (call.opcode() == Opcodes.INVOKESTATIC ? 0 : 1)]);
