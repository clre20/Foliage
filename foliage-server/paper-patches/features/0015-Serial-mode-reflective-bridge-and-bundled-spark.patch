diff --git a/src/main/java/io/github/clre20/foliage/compat/RegionContext.java b/src/main/java/io/github/clre20/foliage/compat/RegionContext.java
index 282cda016c861ec42fd07edb4a7816e8f03ec8a1..3e57cea9f5cd2215596d1c8276f6b1253acff9b8 100644
--- a/src/main/java/io/github/clre20/foliage/compat/RegionContext.java
+++ b/src/main/java/io/github/clre20/foliage/compat/RegionContext.java
@@ -89,6 +89,35 @@ public final class RegionContext {
         return NONE;
     }
 
+    /** Reflective {@code Method#invoke}: enter the region of an NMS entity, block entity or level + block position target. */
+    public static Object enterReflective(final Object target, final Object[] args) {
+        if (!SerialMode.ENABLED || target == null || !TickRegionScheduler.canSwapTickingRegion()) {
+            return NONE;
+        }
+        if (target instanceof net.minecraft.world.entity.Entity handle) {
+            return enterNms(handle);
+        }
+        if (target instanceof net.minecraft.world.level.block.entity.BlockEntity blockEntity) {
+            return blockEntity.getLevel() instanceof ServerLevel level && !blockEntity.isRemoved()
+                ? enter(level, blockEntity.getBlockPos().getX() >> 4, blockEntity.getBlockPos().getZ() >> 4) : NONE;
+        }
+        if (target instanceof ServerLevel level && args != null) {
+            for (final Object arg : args) {
+                if (arg instanceof net.minecraft.core.BlockPos pos) {
+                    return enter(level, pos.getX() >> 4, pos.getZ() >> 4);
+                }
+            }
+            return NONE;
+        }
+        if (target instanceof CraftEntity || target instanceof org.bukkit.inventory.EntityEquipment) {
+            return enterEntity(target);
+        }
+        if (target instanceof Block || target instanceof BlockState) {
+            return enterBlock(target);
+        }
+        return NONE;
+    }
+
     private static Object enterNms(final net.minecraft.world.entity.Entity handle) {
         if (handle == null || !(handle.level() instanceof ServerLevel level)) {
             return NONE;
