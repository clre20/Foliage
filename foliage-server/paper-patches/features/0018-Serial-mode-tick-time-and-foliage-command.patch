diff --git a/src/main/java/io/github/clre20/foliage/compat/SerialTickFrame.java b/src/main/java/io/github/clre20/foliage/compat/SerialTickFrame.java
index 415c6f08833a083b64e26f8fdbde3de9f69ec462..36ca34d5d162a977d50d94cf2db79d8517ae847d 100644
--- a/src/main/java/io/github/clre20/foliage/compat/SerialTickFrame.java
+++ b/src/main/java/io/github/clre20/foliage/compat/SerialTickFrame.java
@@ -19,6 +19,11 @@ public final class SerialTickFrame {
 
     private static final long TICK_NS = 50_000_000L;
 
+    private static final int HISTORY = 100;
+    /** busy time of the last {@link #HISTORY} frames in nanoseconds (ring); written on the tick thread only */
+    private static final long[] history = new long[HISTORY];
+    private static volatile int written;
+
     private static boolean open;
     private static long busyNs;
     private static int number;
@@ -57,10 +62,42 @@ public final class SerialTickFrame {
         }
         open = false;
         final long busy = busyNs;
+        final int w = written;
+        history[w % HISTORY] = busy;
+        written = w + 1;
         new ServerTickEndEvent(number, busy / 1.0E6, TICK_NS - busy).callEvent();
         spark().tickEnd(busy / 1.0E6);
     }
 
+    /** Average busy time of the last 100 server ticks in milliseconds, like Paper's {@code getAverageTickTime()}. */
+    public static double averageTickMillis() {
+        final int n = Math.min(written, HISTORY);
+        if (n == 0) {
+            return 0.0;
+        }
+        long sum = 0L;
+        for (int i = 0; i < n; ++i) {
+            sum += history[i];
+        }
+        return sum / (double) n / 1.0E6;
+    }
+
+    /** Busy time of the last 100 server ticks in nanoseconds, like Paper's {@code getTickTimes()}. */
+    public static long[] tickTimes() {
+        return history.clone();
+    }
+
+    /** Longest busy time among the last {@code frames} server ticks in milliseconds. */
+    public static double maxRecentMillis(final int frames) {
+        final int w = written;
+        final int n = Math.min(Math.min(frames, HISTORY), w);
+        long max = 0L;
+        for (int i = 1; i <= n; ++i) {
+            max = Math.max(max, history[(w - i) % HISTORY]);
+        }
+        return max / 1.0E6;
+    }
+
     private static io.papermc.paper.SparksFly spark() {
         return ((org.bukkit.craftbukkit.CraftServer) org.bukkit.Bukkit.getServer()).spark;
     }
