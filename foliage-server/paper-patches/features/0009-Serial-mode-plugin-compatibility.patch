new file mode 100644
index 0000000000000000000000000000000000000000..986c31c0e720825714bdb10ad868320b1d06a964
--- /dev/null
+++ b/src/main/java/io/github/clre20/foliage/compat/RegionBridgeTransformer.java
@@ -0,0 +1,317 @@
+package io.github.clre20.foliage.compat;
+
+import com.mojang.logging.LogUtils;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.ClassVisitor;
+import org.objectweb.asm.ClassWriter;
+import org.objectweb.asm.Label;
+import org.objectweb.asm.MethodVisitor;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.Type;
+import org.slf4j.Logger;
+
+/**
+ * Rewrites plugin bytecode so that every call into a region-bound Bukkit object runs inside the owning region.
+ * <p>
+ * A call such as {@code entity.setHealth(1.0)} becomes {@code foliage$bridge$0(entity, 1.0)}, a synthetic method added to
+ * the same class:
+ * <pre>
+ * static void foliage$bridge$0(Entity e, double h) {
+ *     Object token = RegionContext.enterEntity(e);
+ *     try { e.setHealth(h); } finally { RegionContext.exit(token); }
+ * }
+ * </pre>
+ * The replacement {@code invokestatic} has exactly the same stack effect as the original call, so the original methods'
+ * stack map frames stay valid and are copied unchanged.
+ */
+public final class RegionBridgeTransformer {
+
+    private static final Logger LOGGER = LogUtils.getClassLogger();
+    private static final String CONTEXT = "io/github/clre20/foliage/compat/RegionContext";
+    private static final String OBJECT = "java/lang/Object";
+    private static final String LOCATION_DESC = "Lorg/bukkit/Location;";
+
+    /** World methods whose (int x, int y, int z) arguments are block coordinates. */
+    private static final Set<String> WORLD_XYZ_BLOCK = Set.of(
+        "getBlockAt", "getBlockData", "getType", "setType", "setBlockData", "getBlockState", "getBiome", "setBiome",
+        "getComputedBiome", "getLightLevel"
+    );
+    /** World methods whose (int x, int z) arguments are block coordinates. */
+    private static final Set<String> WORLD_XZ_BLOCK = Set.of("getHighestBlockAt", "getHighestBlockYAt");
+    /** World methods whose (int x, int z) arguments are chunk coordinates. */
+    private static final Set<String> WORLD_XZ_CHUNK = Set.of(
+        "getChunkAt", "isChunkLoaded", "isChunkGenerated", "loadChunk", "unloadChunk", "unloadChunkRequest",
+        "refreshChunk", "regenerateChunk", "getChunkAtAsync", "isChunkForceLoaded", "setChunkForceLoaded",
+        "addPluginChunkTicket", "removePluginChunkTicket", "getPluginChunkTickets", "isChunkInUse"
+    );
+
+    private static volatile boolean warned;
+
+    private RegionBridgeTransformer() {
+    }
+
+    public static byte[] transform(final String pluginName, final byte[] bytecode) {
+        if (!SerialMode.ENABLED || bytecode == null) {
+            return bytecode;
+        }
+        try {
+            final ClassReader reader = new ClassReader(bytecode);
+            final ClassWriter writer = new ClassWriter(reader, ClassWriter.COMPUTE_MAXS);
+            final BridgeClassVisitor visitor = new BridgeClassVisitor(writer);
+            reader.accept(visitor, 0);
+            return visitor.changed ? writer.toByteArray() : bytecode;
+        } catch (final Throwable thr) {
+            if (!warned) {
+                warned = true;
+                LOGGER.warn("Could not apply region bridges to a class of plugin {}; it is loaded unchanged", pluginName, thr);
+            }
+            return bytecode;
+        }
+    }
+
+    private enum Kind { ENTITY, BLOCK, CHUNK, INVENTORY, LOCATION, WORLD_XYZ, WORLD_XZ_BLOCK, WORLD_XZ_CHUNK }
+
+    private record Call(int opcode, String owner, String name, String desc, boolean itf) {
+    }
+
+    private record Bridge(String name, Call call, Kind kind, int argIndex) {
+    }
+
+    static Kind classify(final String owner, final String name, final String desc) {
+        if (owner.startsWith("org/bukkit/entity/") || owner.startsWith("org/bukkit/craftbukkit/entity/")) {
+            return Kind.ENTITY;
+        }
+        if ((owner.startsWith("org/bukkit/block/") && !owner.startsWith("org/bukkit/block/data/")
+            && !owner.startsWith("org/bukkit/block/banner/") && !owner.startsWith("org/bukkit/block/sign/")
+            && !owner.startsWith("org/bukkit/block/structure/") && !owner.equals("org/bukkit/block/BlockFace")
+            && !owner.equals("org/bukkit/block/Biome") && !owner.equals("org/bukkit/block/BlockType")
+            && !owner.startsWith("org/bukkit/block/BlockType$"))
+            || owner.startsWith("org/bukkit/craftbukkit/block/")) {
+            return owner.startsWith("org/bukkit/craftbukkit/block/data/") ? null : Kind.BLOCK;
+        }
+        if (owner.equals("org/bukkit/Chunk") || owner.equals("org/bukkit/craftbukkit/CraftChunk")) {
+            return Kind.CHUNK;
+        }
+        if ((owner.startsWith("org/bukkit/inventory/") && owner.endsWith("Inventory"))
+            || owner.startsWith("org/bukkit/craftbukkit/inventory/CraftInventory")) {
+            return Kind.INVENTORY;
+        }
+        if (owner.equals("org/bukkit/World") || owner.equals("org/bukkit/RegionAccessor") || owner.equals("org/bukkit/craftbukkit/CraftWorld")) {
+            if (desc.contains(LOCATION_DESC)) {
+                return Kind.LOCATION;
+            }
+            if (desc.startsWith("(III") && WORLD_XYZ_BLOCK.contains(name)) {
+                return Kind.WORLD_XYZ;
+            }
+            if (desc.startsWith("(II") && WORLD_XZ_BLOCK.contains(name)) {
+                return Kind.WORLD_XZ_BLOCK;
+            }
+            if (desc.startsWith("(II") && WORLD_XZ_CHUNK.contains(name)) {
+                return Kind.WORLD_XZ_CHUNK;
+            }
+        }
+        return null;
+    }
+
+    private static final class BridgeClassVisitor extends ClassVisitor {
+
+        private final Map<Call, Bridge> bridges = new LinkedHashMap<>();
+        private String className;
+        private boolean isInterface;
+        private int version;
+        private boolean skip;
+        boolean changed;
+
+        BridgeClassVisitor(final ClassVisitor next) {
+            super(Opcodes.ASM9, next);
+        }
+
+        @Override
+        public void visit(final int version, final int access, final String name, final String signature, final String superName, final String[] interfaces) {
+            this.className = name;
+            this.version = version & 0xFFFF;
+            this.isInterface = (access & Opcodes.ACC_INTERFACE) != 0;
+            // static methods in interfaces need class file version 52 (Java 8)
+            this.skip = (this.isInterface && this.version < Opcodes.V1_8) || name.startsWith("io/github/clre20/foliage/");
+            super.visit(version, access, name, signature, superName, interfaces);
+        }
+
+        @Override
+        public MethodVisitor visitMethod(final int access, final String name, final String descriptor, final String signature, final String[] exceptions) {
+            final MethodVisitor mv = super.visitMethod(access, name, descriptor, signature, exceptions);
+            if (this.skip || mv == null) {
+                return mv;
+            }
+            return new MethodVisitor(Opcodes.ASM9, mv) {
+                @Override
+                public void visitMethodInsn(final int opcode, final String owner, final String mName, final String mDesc, final boolean itf) {
+                    if (opcode == Opcodes.INVOKEINTERFACE || opcode == Opcodes.INVOKEVIRTUAL) {
+                        final Kind kind = classify(owner, mName, mDesc);
+                        if (kind != null) {
+                            final Bridge bridge = BridgeClassVisitor.this.bridgeFor(new Call(opcode, owner, mName, mDesc, itf), kind);
+                            if (bridge != null) {
+                                super.visitMethodInsn(Opcodes.INVOKESTATIC, BridgeClassVisitor.this.className, bridge.name(),
+                                    bridgeDesc(bridge.call()), BridgeClassVisitor.this.isInterface);
+                                BridgeClassVisitor.this.changed = true;
+                                return;
+                            }
+                        }
+                    }
+                    super.visitMethodInsn(opcode, owner, mName, mDesc, itf);
+                }
+            };
+        }
+
+        Bridge bridgeFor(final Call call, final Kind kind) {
+            final Bridge existing = this.bridges.get(call);
+            if (existing != null) {
+                return existing;
+            }
+            int argIndex = -1;
+            if (kind == Kind.LOCATION) {
+                final Type[] args = Type.getArgumentTypes(call.desc());
+                for (int i = 0; i < args.length; i++) {
+                    if (args[i].getDescriptor().equals(LOCATION_DESC)) {
+                        argIndex = i;
+                        break;
+                    }
+                }
+                if (argIndex < 0) {
+                    return null;
+                }
+            }
+            final Bridge bridge = new Bridge("foliage$bridge$" + this.bridges.size(), call, kind, argIndex);
+            this.bridges.put(call, bridge);
+            return bridge;
+        }
+
+        @Override
+        public void visitEnd() {
+            for (final Bridge bridge : this.bridges.values()) {
+                this.emitBridge(bridge);
+            }
+            super.visitEnd();
+        }
+
+        private void emitBridge(final Bridge bridge) {
+            final Call call = bridge.call();
+            final String desc = bridgeDesc(call);
+            final int access = Opcodes.ACC_STATIC | Opcodes.ACC_SYNTHETIC
+                | (this.isInterface && this.version < Opcodes.V9 ? Opcodes.ACC_PUBLIC : Opcodes.ACC_PRIVATE);
+            final MethodVisitor mv = this.cv.visitMethod(access, bridge.name(), desc, null, null);
+            mv.visitCode();
+
+            final Type[] params = Type.getArgumentTypes(desc);
+            final int[] slots = new int[params.length];
+            int slot = 0;
+            for (int i = 0; i < params.length; i++) {
+                slots[i] = slot;
+                slot += params[i].getSize();
+            }
+            final int tokenSlot = slot;
+            final Type ret = Type.getReturnType(desc);
+            final int resultSlot = tokenSlot + 1;
+            final int excSlot = tokenSlot + 1;
+
+            // token = RegionContext.enterX(...)
+            switch (bridge.kind()) {
+                case ENTITY -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterEntity", "(Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
+                case BLOCK -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterBlock", "(Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
+                case CHUNK -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterChunk", "(Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
+                case INVENTORY -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterInventory", "(Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
+                case LOCATION -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, slots[bridge.argIndex() + 1]); // +1: parameter 0 is the receiver
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterLocation", "(Ljava/lang/Object;)Ljava/lang/Object;", false);
+                }
+                case WORLD_XYZ -> { // (receiver, x, y, z, ...)
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[1]);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[3]);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterWorldBlock", "(Ljava/lang/Object;II)Ljava/lang/Object;", false);
+                }
+                case WORLD_XZ_BLOCK -> { // (receiver, x, z, ...)
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[1]);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[2]);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterWorldBlock", "(Ljava/lang/Object;II)Ljava/lang/Object;", false);
+                }
+                case WORLD_XZ_CHUNK -> {
+                    mv.visitVarInsn(Opcodes.ALOAD, 0);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[1]);
+                    mv.visitVarInsn(Opcodes.ILOAD, slots[2]);
+                    mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "enterWorldChunk", "(Ljava/lang/Object;II)Ljava/lang/Object;", false);
+                }
+            }
+            mv.visitVarInsn(Opcodes.ASTORE, tokenSlot);
+
+            final Label start = new Label();
+            final Label end = new Label();
+            final Label handler = new Label();
+            mv.visitTryCatchBlock(start, end, handler, null);
+            mv.visitLabel(start);
+            for (int i = 0; i < params.length; i++) {
+                mv.visitVarInsn(params[i].getOpcode(Opcodes.ILOAD), slots[i]);
+            }
+            mv.visitMethodInsn(call.opcode(), call.owner(), call.name(), call.desc(), call.itf());
+            if (ret.getSort() != Type.VOID) {
+                mv.visitVarInsn(ret.getOpcode(Opcodes.ISTORE), resultSlot);
+            }
+            mv.visitLabel(end);
+            mv.visitVarInsn(Opcodes.ALOAD, tokenSlot);
+            mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "exit", "(Ljava/lang/Object;)V", false);
+            if (ret.getSort() != Type.VOID) {
+                mv.visitVarInsn(ret.getOpcode(Opcodes.ILOAD), resultSlot);
+            }
+            mv.visitInsn(ret.getOpcode(Opcodes.IRETURN));
+
+            mv.visitLabel(handler);
+            if (this.version >= Opcodes.V1_6) {
+                final List<Object> locals = new ArrayList<>();
+                for (final Type p : params) {
+                    locals.add(frameType(p));
+                }
+                locals.add(OBJECT);
+                mv.visitFrame(Opcodes.F_FULL, locals.size(), locals.toArray(), 1, new Object[] {"java/lang/Throwable"});
+            }
+            mv.visitVarInsn(Opcodes.ASTORE, excSlot);
+            mv.visitVarInsn(Opcodes.ALOAD, tokenSlot);
+            mv.visitMethodInsn(Opcodes.INVOKESTATIC, CONTEXT, "exit", "(Ljava/lang/Object;)V", false);
+            mv.visitVarInsn(Opcodes.ALOAD, excSlot);
+            mv.visitInsn(Opcodes.ATHROW);
+            mv.visitMaxs(0, 0); // computed
+            mv.visitEnd();
+        }
+    }
+
+    static String bridgeDesc(final Call call) {
+        return "(L" + call.owner() + ";" + call.desc().substring(1);
+    }
+
+    private static Object frameType(final Type t) {
+        return switch (t.getSort()) {
+            case Type.BOOLEAN, Type.BYTE, Type.CHAR, Type.SHORT, Type.INT -> Opcodes.INTEGER;
+            case Type.FLOAT -> Opcodes.FLOAT;
+            case Type.LONG -> Opcodes.LONG;
+            case Type.DOUBLE -> Opcodes.DOUBLE;
+            case Type.ARRAY -> t.getDescriptor();
+            default -> t.getInternalName();
+        };
+    }
+}
diff --git a/src/main/java/io/github/clre20/foliage/compat/RegionContext.java b/src/main/java/io/github/clre20/foliage/compat/RegionContext.java
new file mode 100644
index 0000000000000000000000000000000000000000..a21166683373858094e167054276392487d65d5e
--- /dev/null
+++ b/src/main/java/io/github/clre20/foliage/compat/RegionContext.java
@@ -0,0 +1,141 @@
+package io.github.clre20.foliage.compat;
+
+import ca.spottedleaf.moonrise.common.util.TickThread;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Chunk;
+import org.bukkit.Location;
+import org.bukkit.block.Block;
+import org.bukkit.block.BlockState;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.entity.CraftEntity;
+
+/**
+ * Temporarily switches the current region to the region owning the object a plugin is about to access.
+ * Every plugin call into a region-bound Bukkit object is wrapped as {@code token = enterX(target); try { call } finally { exit(token); }}
+ * by {@link RegionBridgeTransformer}. Only active in {@link SerialMode}, where no two regions tick at the same time.
+ */
+public final class RegionContext {
+
+    /** Returned when no switch happened. */
+    private static final Object NONE = new Object();
+    /** Returned when the previous region was "no region" (global tick, plugin enable, console). */
+    private static final Object NO_REGION = new Object();
+
+    private RegionContext() {
+    }
+
+    public static Object enterEntity(final Object entity) {
+        if (!SerialMode.ENABLED || !(entity instanceof CraftEntity craft)) {
+            return NONE;
+        }
+        return enterNms(craft.getHandleRaw());
+    }
+
+    public static Object enterBlock(final Object block) {
+        if (!SerialMode.ENABLED) {
+            return NONE;
+        }
+        if (block instanceof Block b) {
+            return enterWorld(b.getWorld(), b.getX() >> 4, b.getZ() >> 4);
+        }
+        if (block instanceof BlockState s && s.isPlaced()) {
+            return enterWorld(s.getWorld(), s.getX() >> 4, s.getZ() >> 4);
+        }
+        return NONE;
+    }
+
+    public static Object enterLocation(final Object location) {
+        if (!SerialMode.ENABLED || !(location instanceof Location loc) || !loc.isWorldLoaded()) {
+            return NONE;
+        }
+        return enterWorld(loc.getWorld(), loc.getBlockX() >> 4, loc.getBlockZ() >> 4);
+    }
+
+    public static Object enterChunk(final Object chunk) {
+        if (!SerialMode.ENABLED || !(chunk instanceof Chunk c)) {
+            return NONE;
+        }
+        return enterWorld(c.getWorld(), c.getX(), c.getZ());
+    }
+
+    public static Object enterInventory(final Object inventory) {
+        if (!SerialMode.ENABLED || !(inventory instanceof org.bukkit.craftbukkit.inventory.CraftInventory craft) || !TickThread.isTickThread()) {
+            return NONE;
+        }
+        // use the underlying container directly: Bukkit's getHolder()/getLocation() may already read the world
+        net.minecraft.world.Container container = craft.getInventory();
+        if (container instanceof net.minecraft.world.CompoundContainer compound) {
+            container = compound.container1;
+        }
+        if (container instanceof net.minecraft.world.level.block.entity.BlockEntity blockEntity
+            && blockEntity.getLevel() instanceof ServerLevel level) {
+            return enter(level, blockEntity.getBlockPos().getX() >> 4, blockEntity.getBlockPos().getZ() >> 4);
+        }
+        if (container instanceof net.minecraft.world.entity.player.Inventory playerInventory) {
+            return enterNms(playerInventory.player);
+        }
+        if (container instanceof net.minecraft.world.entity.Entity entity) {
+            return enterNms(entity);
+        }
+        return NONE;
+    }
+
+    private static Object enterNms(final net.minecraft.world.entity.Entity handle) {
+        if (handle == null || !(handle.level() instanceof ServerLevel level)) {
+            return NONE;
+        }
+        return enter(level, handle.chunkPosition().x(), handle.chunkPosition().z());
+    }
+
+    public static Object enterWorldBlock(final Object world, final int blockX, final int blockZ) {
+        if (!SerialMode.ENABLED) {
+            return NONE;
+        }
+        return enterWorld(world, blockX >> 4, blockZ >> 4);
+    }
+
+    public static Object enterWorldChunk(final Object world, final int chunkX, final int chunkZ) {
+        if (!SerialMode.ENABLED) {
+            return NONE;
+        }
+        return enterWorld(world, chunkX, chunkZ);
+    }
+
+    private static Object enterWorld(final Object world, final int chunkX, final int chunkZ) {
+        if (!(world instanceof CraftWorld craftWorld)) {
+            return NONE;
+        }
+        return enter(craftWorld.getHandle(), chunkX, chunkZ);
+    }
+
+    private static Object enter(final ServerLevel level, final int chunkX, final int chunkZ) {
+        if (!TickThread.isTickThread()) {
+            return NONE;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> target =
+            level.regioniser.getRegionAtUnsynchronised(chunkX, chunkZ);
+        if (target == null) {
+            return NONE;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> current =
+            TickRegionScheduler.getCurrentRegion();
+        if (target == current) {
+            return NONE;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> previous =
+            TickRegionScheduler.swapTickingRegion(target);
+        return previous == null ? NO_REGION : previous;
+    }
+
+    @SuppressWarnings("unchecked")
+    public static void exit(final Object token) {
+        if (token == NONE) {
+            return;
+        }
+        TickRegionScheduler.swapTickingRegion(token == NO_REGION ? null
+            : (ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData>) token);
+    }
+}
diff --git a/src/main/java/io/github/clre20/foliage/compat/SerialMode.java b/src/main/java/io/github/clre20/foliage/compat/SerialMode.java
new file mode 100644
index 0000000000000000000000000000000000000000..9386ac2883cce71451189ea61aaedd2d18da737e
--- /dev/null
+++ b/src/main/java/io/github/clre20/foliage/compat/SerialMode.java
@@ -0,0 +1,20 @@
+package io.github.clre20.foliage.compat;
+
+/**
+ * "Normal mode" for plugins that are not known to be safe for parallel region ticking.
+ * <p>
+ * While enabled, all regions and the global region tick on a single tick thread, so plugin code never runs
+ * concurrently with any region. Plugin calls into objects owned by another region are routed by temporarily
+ * switching the current region (see {@link RegionContext}), which keeps Folia's per-region data consistent.
+ * The result is the same behaviour as a single-threaded Paper server, while the region structure stays in place
+ * for later parallelisation.
+ * <p>
+ * Disable for testing with {@code -Dfoliage.serial-mode=false} (then only Folia-supported plugins may load).
+ */
+public final class SerialMode {
+
+    public static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("foliage.serial-mode", "true"));
+
+    private SerialMode() {
+    }
+}
diff --git a/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java b/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
index f9a2c55a354c877749db3f92956de802ae575788..a4c6e7121189a5aa69468fcd24915a6e47c478d5 100644
--- a/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
+++ b/src/main/java/io/papermc/paper/plugin/entrypoint/classloader/PaperClassloaderBytecodeModifier.java
@@ -7,6 +7,6 @@ public class PaperClassloaderBytecodeModifier implements ClassloaderBytecodeModi
 
     @Override
     public byte[] modify(PluginMeta configuration, byte[] bytecode) {
-        return bytecode;
+        return io.github.clre20.foliage.compat.RegionBridgeTransformer.transform(configuration.getName(), bytecode); // Foliage - serial mode region bridges
     }
 }
diff --git a/src/main/java/io/papermc/paper/plugin/provider/type/paper/PaperPluginProviderFactory.java b/src/main/java/io/papermc/paper/plugin/provider/type/paper/PaperPluginProviderFactory.java
index 6369b13e1fcdbdb25dd9d6e4d3bffdedbee4f739..07e07e24b1d67000fad5b93ae0654d0364f462f1 100644
--- a/src/main/java/io/papermc/paper/plugin/provider/type/paper/PaperPluginProviderFactory.java
+++ b/src/main/java/io/papermc/paper/plugin/provider/type/paper/PaperPluginProviderFactory.java
@@ -25,7 +25,7 @@ class PaperPluginProviderFactory implements PluginTypeFactory<PaperPluginParent,
     @Override
